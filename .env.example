# Copy to .env for local runtime. Use frontdesk_dev_runtime.
# Owner URLs belong in .env.migrate. Integration runtime URL belongs in .env.test.
NODE_ENV=development
PORT=3000
DATABASE_URL=
BUSINESS_TIMEZONE=Asia/Kolkata
TRUST_PROXY=false

# Reserved for the Phase 3 session service.
SESSION_COOKIE_NAME=frontdesk_session
SESSION_TTL_HOURS=8
