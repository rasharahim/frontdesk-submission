{
  "name": "@frontdesk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/app.test.ts test/sla.test.ts",
    "test:db": "vitest run test/db.test.ts test/api.db.test.ts test/sla-repair.db.test.ts --no-file-parallelism",
    "seed": "tsx prisma/seed.ts",
    "sla:backfill": "tsx prisma/backfill-sla.ts",
    "sla:repair": "tsx prisma/repair-sla.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/supertest": "6.0.3",
    "prisma": "7.10.1",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
