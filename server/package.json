{
  "name": "@frontdesk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --names types,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/app.test.ts test/sla.test.ts test/lifecycle.test.ts",
    "test:db": "npm run build && vitest run test/db.test.ts test/api.db.test.ts test/sla-repair.db.test.ts test/incidents.db.test.ts --no-file-parallelism",
    "build:maintenance": "tsc -p tsconfig.maintenance.json",
    "seed": "npm run build:maintenance && node .tmp/maintenance/prisma/seed.js",
    "sla:backfill": "npm run build:maintenance && node .tmp/maintenance/prisma/backfill-sla.js",
    "sla:repair": "npm run build:maintenance && node .tmp/maintenance/prisma/repair-sla.js",
    "lifecycle:demo": "npm run build:maintenance && node .tmp/maintenance/prisma/lifecycle-demo.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/supertest": "6.0.3",
    "prisma": "7.10.1",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
